<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifier les nouveaux messages : indispensable depuis Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Faire vibrer, et reprendre les vérifications après un redémarrage. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- La carte QR de chaque salariée contient l'adresse de son espace
                 personnel. Sans ce filtre, le scan ouvre le navigateur ; avec lui,
                 Android propose (ou choisit) PilotRH, l'application mémorise le
                 jeton et il n'y a plus jamais besoin de rescanner la carte.
                 Le domaine est renseigné à la compilation via APP_HOST. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/app_host" android:pathPrefix="/moi" />
                <data android:scheme="http" android:host="@string/app_host" android:pathPrefix="/moi" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReglagesActivity"
            android:exported="false"
            android:label="@string/reg_titre"
            android:screenOrientation="portrait" />

        <!-- Réveil périodique : demande au serveur s'il y a de nouveaux messages. -->
        <receiver android:name=".Verificateur" android:exported="false">
            <intent-filter>
                <action android:name="tn.dbsfashion.pilotrh.VERIFIER" />
            </intent-filter>
        </receiver>

        <!-- Sans ce receveur, les notifications s'arrêtent après un redémarrage
             du téléphone jusqu'à la prochaine ouverture de l'application. -->
        <receiver android:name=".Verificateur$AuDemarrage" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

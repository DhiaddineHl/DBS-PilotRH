<resources>
    <string name="app_name">PilotRH</string>

    <!-- Domaine de votre serveur, SANS https:// ni barre finale.
         Il sert au filtre d'intention : quand une salariée scanne sa carte QR,
         Android ouvre alors PilotRH au lieu du navigateur.
         Remplacez cette valeur par la vôtre (ex. pilotrh-dbs.up.railway.app).
         Laissée telle quelle, l'application fonctionne mais le scan de carte
         continuera d'ouvrir le navigateur. -->
    <string name="app_host">exemple.invalid</string>

    <string name="reglage_titre">Adresse de PilotRH</string>
    <string name="reglage_aide">Saisissez l\'adresse indiquée par le service RH. Elle n\'est demandée qu\'une seule fois.</string>
    <string name="reglage_exemple">pilotrh-dbs.up.railway.app</string>
    <string name="reglage_valider">Continuer</string>
    <string name="reglage_invalide">Adresse incompréhensible. Exemple : pilotrh-dbs.up.railway.app ou 192.168.1.20:8000</string>
    <string name="reglage_note">Sur le réseau de l\'usine, l\'adresse est celle de l\'ordinateur qui fait tourner PilotRH (par exemple 192.168.1.20:8000).</string>


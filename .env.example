# ---------------------------------------------------------------------------
# PilotRH — configuration
# ---------------------------------------------------------------------------

# OBLIGATOIRE au premier démarrage. Si elle est absente, le serveur génère un
# mot de passe aléatoire et l'affiche UNE SEULE FOIS dans les journaux.
# (Auparavant, sans cette variable, le compte admin était créé avec le mot de
# passe « admin ».)
PILOTRH_ADMIN_PASSWORD=changez-moi-8-caracteres-minimum

# Dépannage uniquement — remet le mot de passe du compte « admin » à cette valeur
# au démarrage, puis À RETIRER (sinon il est réécrit à chaque redémarrage).
# PILOTRH_RESET_ADMIN=

# Recommandé : clé de signature des cookies de session. Si elle n'est pas
# définie, elle est générée et stockée en base. La définir ici permet de la
# faire tourner pour déconnecter toutes les sessions d'un coup.
# PILOTRH_SESSION_SECRET=

# Recommandé si le serveur est public : adresse utilisée dans les QR codes.
# Sans elle, l'adresse est déduite de l'en-tête Host envoyé par le client, qui
# peut être falsifié pour générer des QR pointant vers un site tiers.
# PILOTRH_PUBLIC_URL=https://votre-app.up.railway.app

# Optionnel — active l'OCR des documents et l'assistant IA
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optionnel — lecture automatique du .mdb si le serveur est DANS le réseau de
# l'usine. Sur Railway/cloud, utilisez plutôt pilotrh_agent.py côté usine.
# PILOTRH_MDB_PATH=/mnt/pointeuse/attBackup.mdb
# PILOTRH_SYNC_MINUTES=60

# Optionnel — restreint les adresses que /api/pull-device peut contacter.
# Par défaut, seules les adresses privées (192.168.x.x, 10.x.x.x) sont permises.
# PILOTRH_DEVICE_ALLOWLIST=192.168.1.201

# Optionnel
# PILOTRH_STATE_WINDOW_DAYS=70    # fenêtre de pointages chargée à l'ouverture
# PILOTRH_BACKUP_HOURS=24         # fréquence de la sauvegarde automatique
# PILOTRH_BACKUP_KEEP=30          # nombre de sauvegardes conservées
# PILOTRH_MAX_UPLOAD_MB=40        # taille maximale d'un fichier envoyé
# PILOTRH_AI_QUOTA=40             # requêtes IA par compte et par heure
# PILOTRH_COOKIE_SECURE=auto      # auto | 1 | 0
# PILOTRH_SEED=0                  # 0 = ne pas amorcer depuis seed/attBackup.mdb
# TZ=Africa/Tunis

# Poste local Windows uniquement — DÉSACTIVE TOUTE AUTHENTIFICATION.
# À n'utiliser que si le serveur écoute exclusivement sur 127.0.0.1.
# Avec --host 0.0.0.0, toute machine du réseau obtient l'administration complète.
# PILOTRH_OPEN=1
